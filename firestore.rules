rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Lookups
    function getUserData(userId) { return get(/databases/$(database)/documents/users/$(userId)).data; }
    function isAdmin() { 
      // Only if we have a way to check admins. We'll use a bootstrap logic or check a dedicated admins collection if populated.
      // For this app, let's assume admins have a 'role' field in their user doc.
      // NOTE: get() is expensive in list rules, so use sparingly.
      return isSignedIn() && getUserData(request.auth.uid).role == 'admin';
    }

    // --- Validation Blueprints ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.keys().size() >= 4 &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role in ['student', 'parent', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['title', 'price']) &&
             data.title is string && data.title.size() <= 100 &&
             data.price is number;
    }

    function isValidMentalMathSession(data) {
      return data.keys().hasAll(['studentId', 'score', 'timestamp']) &&
             data.studentId == request.auth.uid &&
             data.score is number &&
             data.timestamp == request.time;
    }

    function isValidFranchiseInquiry(data) {
      return data.keys().hasAll(['email', 'name', 'createdAt']) &&
             data.email is string && data.email.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             data.createdAt == request.time;
    }

    // --- Match Blocks ---

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin(); // Only admins can list users
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && (
        // Prevent role escalation
        incoming().role == existing().role &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email
      );
    }

    match /courses/{courseId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isAdmin() && isValidCourse(incoming());
    }

    match /mentalMathSessions/{sessionId} {
      allow read: if isSignedIn() && (isOwner(existing().studentId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidMentalMathSession(incoming());
    }

    match /performanceMetrics/{metricId} {
      // metricId is usually studentId
      allow read: if isSignedIn() && (isOwner(metricId) || isAdmin() || (getUserData(request.auth.uid).role == 'parent' && getUserData(metricId).parentUid == request.auth.uid));
      allow write: if isAdmin(); // Or system-only
    }

    match /franchiseInquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if isValidFranchiseInquiry(incoming());
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow update: if isSignedIn() && isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }
  }
}
